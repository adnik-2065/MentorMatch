# Copy to .env.local for your own Postgres server, or run npm run db:local:setup
# to generate local credentials automatically. Server-only — never prefix with NEXT_PUBLIC_.
# Leave unset to run without server-side storage (the UI says so).
DATABASE_URL="postgresql://postgres:dev@localhost:5432/mentormatch"

# Optional: a throwaway database for `npm test` integration tests (tables get truncated).
# TEST_DATABASE_URL="postgresql://postgres:dev@localhost:5432/mentormatch_test"
