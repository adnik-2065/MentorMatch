# Copy to .env.local and fill in. Everything here is read on the server only —
# none of these are prefixed NEXT_PUBLIC_, so none of them reach the browser.

# ── Database (required) ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:pass@host:5432/mentormatch?sslmode=require"
# Separate database used by `npm test` — it is wiped between test files.
TEST_DATABASE_URL="postgresql://user:pass@host:5432/mentormatch_test"

# ── Auth (required) ──────────────────────────────────────────────────────────
# Signs one-time sign-in codes. Generate with: openssl rand -base64 36
AUTH_SECRET=""

# ── Email (required in production) ───────────────────────────────────────────
# Sign-in codes are sent through Resend. Without a key, development builds
# print the code to the server console instead; production refuses to sign in.
RESEND_API_KEY=""
EMAIL_FROM="MentorMatch <no-reply@your-domain.edu>"

# ── AI (required for roadmap generation and adaptive suggestions) ────────────
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
# Check https://ai.google.dev/gemini-api/docs/models — model IDs rotate.
GEMINI_MODEL="gemini-3.5-flash"
# Per-call timeout for the provider, in milliseconds.
AI_TIMEOUT_MS="90000"

# ── Optional ─────────────────────────────────────────────────────────────────
# Pre-created shadow database for `prisma migrate dev`, if your Postgres user
# can't create databases (or template1 is unusable).
SHADOW_DATABASE_URL=""
